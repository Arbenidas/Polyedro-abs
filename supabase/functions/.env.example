# Configure these values as Supabase secrets. Never expose them in Angular.
# Solo DeepSeek y MiMo: no se usa Alibaba ni generación de imágenes raster.

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# MiMo (API compatible con OpenAI): visión y texto.
# - MIMO_VISION_MODEL (mimo-v2.5) analiza imágenes de referencia → spec editable.
# - MIMO_TEXT_MODEL (mimo-v2.5-pro) se usa para tareas de texto puro si hace falta.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_VISION_MODEL=mimo-v2.5
MIMO_TEXT_MODEL=mimo-v2.5-pro

# EDITORIAL_STYLE (opcional): dirección estética que respetan los razonadores
# al componer assets vectoriales editables y layouts.
# Valores: neobrutal (default), editorial, tech, minimal, premium, grunge,
# render3d, ilustrado, brutalist, pop-art, art-deco, botanico.
EDITORIAL_STYLE=neobrutal
